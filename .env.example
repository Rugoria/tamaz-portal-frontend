# Where the Spring Boot backend is running (server-side only, never sent to the browser).
BACKEND_URL=http://localhost:8080

# Screens for things the client has not decided yet (patient records, photos and X-rays, treatment plan,
# virtual setup review, tracking numbers, appointments, payments, per-case chat) are built as preview-only
# UI with a "Pending client decision" tag. Set to "false" to hide them all.
NEXT_PUBLIC_SHOW_PENDING=true
